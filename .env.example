# =============================================================================
# CASEFILE ZERO: AI Interrogation Environment Configuration
# =============================================================================
# Obtain a Groq API Key at https://console.groq.com/keys
# Copy this file to .env.local and set your key:
#   cp .env.example .env.local
#
# IMPORTANT: Never commit .env.local to Git. It is automatically git-ignored.
# =============================================================================

# Groq Cloud API Key (required for real-time AI suspect dialogue)
GROQ_API_KEY=

# Optional: Groq chat model (defaults to llama-3.3-70b-versatile)
# Supported options: llama-3.3-70b-versatile, llama-3.1-8b-instant, mixtral-8x7b-32768
GROQ_MODEL=llama-3.3-70b-versatile
